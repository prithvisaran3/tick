#!/usr/bin/env bash
# Blocks a commit that adds anything that looks like a secret. Install once: git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$'; then
  echo "refusing to commit a .env file" >&2; exit 1
fi
python3 tools/secret_scan.py
