{
  "$comment": "Source of truth for motion. Springs with a small overshoot; no slideshow easing.",
  "springs": {
    "standard": {"stiffness": 380, "damping": 28, "mass": 1},
    "pop":      {"stiffness": 520, "damping": 18, "mass": 1},
    "sheet":    {"stiffness": 300, "damping": 30, "mass": 1}
  },
  "reduceMotion": {"fadeMs": 150},
  "moments": {
    "sticker_slap": {"spring": "pop", "tiltDeg": 2.5, "fromScale": 0.6, "fromTiltDeg": -8},
