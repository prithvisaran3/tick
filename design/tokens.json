  "space": {"x1": 4, "x2": 8, "x3": 12, "x4": 16, "x5": 20, "x6": 24, "x8": 32, "x10": 40, "x12": 48, "x16": 64},
  "radius": {"card": 24, "pill": 999, "sheet": 32, "small": 12},
  "layout": {"screenWidth": 393, "screenHeight": 852, "gutter": 20, "tabBarHeight": 84, "stickerTiltDeg": 2.5}
