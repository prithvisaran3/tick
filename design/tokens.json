{
  "$comment": "Source of truth. tools/gen_tokens.py -> app/lib/design/tokens.g.dart and design/tokens.css. Never hand-edit generated files.",
  "palette": {
    "ink": "#0E0E12",
    "volt": "#C8FF2E",
    "paper": "#F5F3EC",
    "graphite": "#5B5B66",
    "clay": "#FF6B4A",
    "sky": "#7AA7FF",
    "ink2": "#18181E",
    "ink3": "#222229",
    "mist": "#A3A3AF",
    "line_dark": "#2E2E37",
    "paper2": "#FBFAF6",
    "paper3": "#EAE7DC",
    "line_light": "#D9D5C8",
    "clay_deep": "#B8381A",
    "sky_deep": "#2A57C0",
    "white": "#FFFFFF"
  },
  "themes": {
    "dark": {
      "bg": "ink", "surface1": "ink2", "surface2": "ink3", "hairline": "line_dark",
      "text": "paper", "textSecondary": "mist",
      "accent": "volt", "onAccent": "ink",
      "moneyIn": "volt", "moneyOut": "paper",
      "alert": "clay", "incoming": "sky",
      "receiptBg": "paper", "receiptText": "ink", "receiptMuted": "graphite"
    },
    "light": {
      "bg": "paper", "surface1": "paper2", "surface2": "paper3", "hairline": "line_light",
      "text": "ink", "textSecondary": "graphite",
      "accent": "volt", "onAccent": "ink",
      "moneyIn": "ink", "moneyOut": "ink",
      "alert": "clay_deep", "incoming": "sky_deep",
      "receiptBg": "paper2", "receiptText": "ink", "receiptMuted": "graphite"
    }
  },
  "contrast": [
    {"theme": "dark",  "fg": "text",          "bg": "bg",       "min": 4.5, "note": "body on ink"},
    {"theme": "dark",  "fg": "text",          "bg": "surface1", "min": 4.5, "note": "body on card"},
    {"theme": "dark",  "fg": "text",          "bg": "surface2", "min": 4.5, "note": "body on raised card"},
    {"theme": "dark",  "fg": "textSecondary", "bg": "bg",       "min": 4.5, "note": "secondary on ink"},
    {"theme": "dark",  "fg": "textSecondary", "bg": "surface1", "min": 4.5, "note": "secondary on card"},
    {"theme": "dark",  "fg": "textSecondary", "bg": "surface2", "min": 4.5, "note": "secondary on raised card"},
    {"theme": "dark",  "fg": "moneyIn",       "bg": "bg",       "min": 4.5, "note": "volt on ink"},
    {"theme": "dark",  "fg": "moneyIn",       "bg": "surface1", "min": 4.5, "note": "volt on card"},
    {"theme": "dark",  "fg": "alert",         "bg": "bg",       "min": 4.5, "note": "clay on ink"},
    {"theme": "dark",  "fg": "alert",         "bg": "surface1", "min": 4.5, "note": "clay on card"},
    {"theme": "dark",  "fg": "incoming",      "bg": "bg",       "min": 4.5, "note": "sky on ink"},
    {"theme": "dark",  "fg": "incoming",      "bg": "surface1", "min": 4.5, "note": "sky on card"},
    {"theme": "dark",  "fg": "onAccent",      "bg": "accent",   "min": 4.5, "note": "ink on volt"},
    {"theme": "light", "fg": "text",          "bg": "bg",       "min": 4.5, "note": "ink on paper"},
    {"theme": "light", "fg": "text",          "bg": "surface1", "min": 4.5, "note": "ink on card"},
    {"theme": "light", "fg": "text",          "bg": "surface2", "min": 4.5, "note": "ink on raised card"},
    {"theme": "light", "fg": "textSecondary", "bg": "bg",       "min": 4.5, "note": "graphite on paper"},
    {"theme": "light", "fg": "textSecondary", "bg": "surface1", "min": 4.5, "note": "graphite on card"},
    {"theme": "light", "fg": "textSecondary", "bg": "surface2", "min": 4.5, "note": "graphite on raised card"},
    {"theme": "light", "fg": "alert",         "bg": "bg",       "min": 4.5, "note": "clay deep on paper"},
    {"theme": "light", "fg": "alert",         "bg": "surface1", "min": 4.5, "note": "clay deep on card"},
    {"theme": "light", "fg": "incoming",      "bg": "bg",       "min": 4.5, "note": "sky deep on paper"},
    {"theme": "light", "fg": "incoming",      "bg": "surface1", "min": 4.5, "note": "sky deep on card"},
    {"theme": "light", "fg": "onAccent",      "bg": "accent",   "min": 4.5, "note": "ink on volt"},
    {"theme": "dark",  "fg": "receiptText",   "bg": "receiptBg","min": 4.5, "note": "morning receipt body"},
    {"theme": "dark",  "fg": "receiptMuted",  "bg": "receiptBg","min": 4.5, "note": "morning receipt muted"},
    {"theme": "dark",  "fg": "accent",        "bg": "bg",       "min": 3.0, "note": "volt fill vs ink (UI component)"}
  ],
  "forbidden": [
    {"fg": "volt", "bg": "paper", "note": "Volt is a fill, never text on Paper (1.06:1)"}
