{
  "$comment": "Source of truth for Tick's haptic language. tools/compile_ahap.py -> app/assets/haptics/*.ahap + manifest.json. One pattern, one meaning. times in ms, intensity/sharpness 0..1.",
  "patterns": {
    "pop": {
      "number": 1,
      "name": "The Pop",
      "meaning": "Haptic logo: app launch / first open of the day.",
      "events": [
        {
          "t": 0,
          "type": "transient",
          "i": 0.6,
          "s": 0.9
        },
        {
          "t": 120,
          "type": "transient",
          "i": 0.9,
          "s": 0.2
        }
      ]
    },
    "price_weight": {
      "number": 2,
      "name": "Price weight",
      "meaning": "A sticker amount landing; heavier for bigger money.",
      "tiers": {
        "low": {
          "rule": "under $20",
          "events": [
            {
              "t": 0,
              "type": "transient",
              "i": 0.4,
              "s": 0.7
            }
          ]
        },
        "mid": {
          "rule": "under $100",
          "events": [
            {
              "t": 0,
              "type": "transient",
              "i": 0.7,
              "s": 0.45
            }
          ]
        },
        "high": {
          "rule": "$100 and up",
          "events": [
            {
              "t": 0,
              "type": "transient",
              "i": 1.0,
              "s": 0.2
            }
          ]
        }
      }
    },
