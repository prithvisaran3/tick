# Names only. Copy to .env locally and fill in. Never commit .env.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_IOS_CLIENT_ID=
OPENROUTER_API_KEY=
# optional (Gemini provider is disabled by default):
GEMINI_API_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_SANDBOX_SECRET=
PLAID_ENV=
RAILWAY_TOKEN=
# Generated by us, lives in Railway env + Supabase Vault:
CRON_SECRET=
# App-side (derived): API_BASE_URL=
# Optional: Plaid OAuth redirect (must first be registered in the Plaid dashboard, see docs/NEXT.md)
PLAID_REDIRECT_URI=
AI_PROVIDER=openrouter
AI_DAILY_CALL_LIMIT=40
